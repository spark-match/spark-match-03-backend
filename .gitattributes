# gitattributes for spark-match-03-backend
#
# Enforce LF line endings for all text files in the repo. This:
#   - ensures consistent behavior across dev (mixed OS) + CI (Linux)
#   - lets us drop the `new-lines: disable` workaround in .yamllint.yml
#     (which we needed because yamllint's default `new-lines: platform`
#     rule failed differently on Windows vs Linux)
#   - aligns with the convention used by most Node.js + TypeScript repos
#     in the ecosystem (e.g., node_modules tooling expects LF)

# Default: treat all files as text, normalize to LF on commit.
* text=auto eol=lf

# Explicit overrides for binary files (defensive; auto-detection
# usually handles these correctly but be explicit just in case).
# (none currently -- all tracked files are text)

# Mark specific paths that should remain LF even if some tooling
# tries to add CRLF (e.g., Windows shell scripts). Already handled
