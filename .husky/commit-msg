#!/usr/bin/env sh
# .husky/commit-msg
# =============================================================================
# Zero-dependency Conventional Commits validator.
# =============================================================================
# Mirrors the CI-side commitlint job (.commitlintrc.json + ci.yml commitlint
# step) so contributors get fast feedback at commit time, before the server-
# side check rejects the push. Pure POSIX sh + grep/awk/wc; no node, no npm.
#
# Rules enforced (subset of @commitlint/config-conventional):
#   1. Subject is non-empty.
#   2. Subject matches: <type>(<scope>)<optional !>: <subject>
#      - <type> must be one of:
#        feat fix chore docs refactor test build ci perf revert
#      - <scope> is required and must be kebab-case (no uppercase, no spaces).
#   3. Subject length is <= 100 chars.
#   4. Subject does not end with '.'.
#   5. Merge commits (auto-generated by git for merges) are allowed verbatim.
#
# Scope-value validation against the canonical scope-enum is intentionally
# NOT enforced here: the script would drift from .commitlintrc.json over time.
# The CI job is the source of truth for the exact list (see AGENTS.md B13).
# =============================================================================

set -e

COMMIT_MSG_FILE="$1"
SUBJECT=$(awk 'NF && !/^#/ {print; exit}' "$COMMIT_MSG_FILE")

# Allow merge commits (git auto-generates them, often long and not CC).
case "$SUBJECT" in
  "Merge "*) exit 0 ;;
esac

fail() {
  printf 'commit-msg: %s\n' "$1" >&2
  printf '  got:      %s\n' "$SUBJECT" >&2
  printf '  help:     https://github.com/spark-match/spark-match-03-backend/blob/main/AGENTS.md#4-pull-request-workflow\n' >&2
  exit 1
}

# 1. Non-empty subject
if [ -z "$SUBJECT" ]; then
  fail 'subject is empty'
fi

# 2. Conventional Commits format: <type>(<scope>)<optional !>: <subject>
#    Subject chars: anything except leading period or trailing whitespace.
if ! printf '%s\n' "$SUBJECT" | grep -qE '^(feat|fix|chore|docs|refactor|test|build|ci|perf|revert)\([a-z][a-z0-9-]*\)!?: .+'; then
  fail 'subject does not match <type>(<scope>): <subject> (or <type>(<scope>)!: <subject> for breaking changes)'
fi

# 3. Header length <= 100 chars
LEN=$(printf '%s' "$SUBJECT" | wc -c | tr -d ' ')
if [ "$LEN" -gt 100 ]; then
  fail "subject exceeds 100 chars (got $LEN)"
fi

# 4. No trailing period
case "$SUBJECT" in
  *.) fail 'subject must not end with a period' ;;
esac
